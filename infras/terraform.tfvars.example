# Authentication is intentionally absent. Use AWS SSO or AWS_PROFILE.
aws_region   = "ap-southeast-2"
project_name = "rmit-society"
environment  = "demo"
owner        = "s1234567"
# Optional: map a registered DNS name to API Gateway with a regional ACM
# certificate in the same AWS region. Without these values, API Gateway's
# generated HTTPS URL is used.
# api_custom_domain_name            = "community.example.com"
# api_custom_domain_certificate_arn = "arn:aws:acm:ap-southeast-2:123456789012:certificate/uuid"
app_desired_count = 0

# Set true only when you want `tofu destroy` to remove non-empty demo buckets.
force_destroy_buckets = false

# ---- Lambda + Bedrock content analysis (Phase 0 gated) ----
# Leave disabled until Phase 0 confirms LabRole trust permits lambda.amazonaws.com
# and the Bedrock model is enabled in the active lab. When enabling, set:
#   enable_content_analysis_lambda         = true
#   content_analysis_bedrock_model_id      = "amazon.nova-lite-v1:0"
#   content_analysis_zip_path              = "../backend/dist-function/content-analysis.zip"
