# Authentication is intentionally absent. Use AWS SSO or AWS_PROFILE.
aws_region   = "us-east-1"
project_name = "rmit-society"
environment  = "demo"
owner        = "s1234567"
# Optional: map a registered DNS name to API Gateway with a regional ACM
# certificate in the same AWS region. Without these values, API Gateway's
# generated HTTPS URL is used.
# api_custom_domain_name            = "community.example.com"
# api_custom_domain_certificate_arn = "arn:aws:acm:ap-southeast-2:123456789012:certificate/uuid"
app_desired_count = 0

# Enable Mapbox place search/location attachments. After apply, populate the
# reported mapbox_secret_token_secret_arn in Secrets Manager.
# enable_mapbox = true

# Set true only when you want `tofu destroy` to remove non-empty demo buckets.
force_destroy_buckets = false

# ---- Lambda + OpenRouter/DeepSeek content analysis (Phase 0 gated) ---------
# Leave disabled until Phase 0 confirms LabRole trust permits lambda.amazonaws.com
# and the role can read the OpenRouter API-key secret. When enabling, set:
#   enable_content_analysis_lambda    = true
#   content_analysis_mode             = "shadow"
#   content_analysis_openrouter_model = "deepseek/<approved-model-slug>"
#   content_analysis_zip_path          = "../backend/dist-function/content-analysis.zip"
# After apply, populate the reported secret ARN with the OpenRouter API key.
# Confidence threshold [0,1] for auto-removing a reviewed thread with a
# high-severity finding (default 0.90; no effect in off/shadow mode).
# content_analysis_auto_remove_confidence = 0.90

# ---- Analytics Glue + Athena pipeline (gated) -------------------------------
# Build the workflow Lambda from backend before applying infrastructure.
# Enable only after verifying the active Learner Lab supports Step Functions
# and the pre-created LabRole trusts states.amazonaws.com and
# lambda.amazonaws.com.
#   enable_analytics_pipeline = true
#   analytics_learner_lab_permissions_confirmed = true
# The nightly trigger uses EventBridge + API destination and the same backend
# scheduler secret. See infras/scheduling.tf.
#   analytics_glue_job_name = "asm3-prod-analytics-metrics-export"
# Raw action-event Parquet and manifest retention (days).
#   analytics_raw_event_retention_days = 30
