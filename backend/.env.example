NODE_ENV=development
HOST=0.0.0.0
PORT=3000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rmit_society:rmit_society_dev@localhost:5432/rmit_society
DATABASE_SSL=false
DATABASE_POOL_MAX=10
ALLOWED_EMAIL_DOMAINS=rmit.edu.au,rmit.edu.vn,rmit.edu.eu,rmit.eu
# Set both values to use a remote S3 media bucket during local development.
# Credentials use the standard AWS SDK chain (environment, AWS_PROFILE, or IAM).
# AWS Academy's temporary voclabs credentials stop working when the lab session
# ends; refresh them and restart the API before requesting a new upload URL.
# AWS_REGION=us-east-1
# MEDIA_BUCKET=rmit-society-dev-media-account-id

# Optional local content-analysis Lambda settings. Do not commit the key.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=deepseek/<approved-model-slug>
# OPENROUTER_API_KEY=""

# Content-analysis auto-removal confidence threshold ([0,1]; default 0.90;
# no effect in off/shadow mode).
# CONTENT_ANALYSIS_AUTO_REMOVE_CONFIDENCE=0.90

# Optional Step Functions analytics orchestration. The backend starts a
# Standard workflow; Step Functions owns Glue/Athena waiting and the workflow
# Lambda persists completed metrics.
# ANALYTICS_REFRESH_STATE_MACHINE_ARN=arn:aws:states:us-east-1:123456789012:stateMachine:rmit-society-demo-analytics-refresh
# ANALYTICS_SCHEDULER_SECRET=""

# Required in production. Supply a random hex or base64 key of at least 32 bytes.
ANALYTICS_PSEUDONYM_KEY=""

# Optional Mapbox server token for place search and reverse geocoding.
# Production ECS receives this from AWS Secrets Manager.
# MAPBOX_SECRET_TOKEN=""
ANALYTICS_PSEUDONYM_KEY_VERSION=v1
