e="" style="opacity=0;fillOpacity=0;strokeOpacity=0;" vertex="1" parent="1"&gt;&lt;mxGeometry x="1179" y="499" width="2" height="2" as="geometry" /&gt;&lt;/mxCell&gt;&lt;mxCell id="31" value="5. Transactional SQL read / write" style="endArrow=open;endFill=0;html=1;rounded=0;strokeWidth=1.5;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="29" target="30"&gt;&lt;mxGeometry relative="1" as="geometry" /&gt;&lt;/mxCell&gt;&lt;mxCell id="32" value="" style="opacity=0;fillOpacity=0;strokeOpacity=0;" vertex="1" parent="1"&gt;&lt;mxGeometry x="1179" y="539" width="2" height="2" as="geometry" /&gt;&lt;/mxCell&gt;&lt;mxCell id="33" value="" style="opacity=0;fillOpacity=0;strokeOpacity=0;" vertex="1" parent="1"&gt;&lt;mxGeometry x="909" y="539" width="2" height="2" as="geometry" /&gt;&lt;/mxCell&gt;&lt;mxCell id="34" value="Database result" style="endArrow=open;endFill=0;html=1;rounded=0;strokeWidth=1.5;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=4 4;" edge="1" parent="1" source="32" target="33"&gt;&lt;mxGeometry relative="1" as="geometry" /&gt;&lt;/mxCell&gt;&lt;mxCell id="35" value="" style="opacity=0;fillOpacity=0;strokeOpacity=0;" vertex="1" parent="1"&gt;&lt;mxGeometry x="909" y="584" width="2" height="2" as="geometry" /&gt;&lt;/mxCell&gt;&lt;mxCell id="36" value="" style="opacity=0;fillOpacity=0;strokeOpacity=0;" vertex="1" parent="1"&gt;&lt;mxGeometry x="639" y="584" width="2" height="2" as="geometry" /&gt;&lt;/mxCell&gt;&lt;mxCell id="37" value="6. HTTP response" style="endArrow=open;endFill=0;html=1;rounded=0;strokeWidth=1.5;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=4 4;" edge="1" parent="1" source="35" target="36"&gt;&lt;mxGeometry relative="1" as="geometry" /&gt;&lt;/mxCell&gt;&lt;mxCell id="38" value="" style="opacity=0;fillOpacity=0;strokeOpacity=0;" vertex="1" parent="1"&gt;&lt;mxGeometry x="639" y="629" width="2" height="2" as="geometry" /&gt;&lt;/mxCell&gt;&lt;mxCell id="39" value="" style="opacity=0;fillOpacity=0;strokeOpacity=0;" vertex="1" parent="1"&gt;&lt;mxGeometry x="99" y="629" width="2" height="2" as="geometry" /&gt;&lt;/mxCell&gt;&lt;mxCell id="40" value="Response rendered in SPA" style="endArrow=open;endFill=0;html=1;rounded=0;strokeWidth=1.5;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=4 4;" edge="1" parent="1" source="38" target="39"&gt;&lt;mxGeometry relative="1" as="geometry" /&gt;&lt;/mxCell&gt;&lt;mxCell id="41" value="4. &amp;lt;b&amp;gt;Inside ECS:&amp;lt;/b&amp;gt; Hono route → session middleware → Controller → Application service → domain policy → Repository port → Drizzle repository." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E04B2A;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"&gt;&lt;mxGeometry x="140" y="405" width="380" height="68" as="geometry" /&gt;&lt;/mxCell&gt;&lt;mxCell id="42" value="One deployable backend with explicit module boundaries: lower operational cost and simpler transaction handling; not independently deployed microservices." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"&gt;&lt;mxGeometry x="140" y="490" width="380" height="64" as="geometry" /&gt;&lt;/mxCell&gt;&lt;mxCell id="43" value="Figure 3. Transport, application policy, and persistence responsibilities stay separate within the request sequence." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;fontColor=#64748B;align=left;" vertex="1" parent="1"&gt;&lt;mxGeometry x="30" y="704" width="1220" height="25" as="geometry" /&gt;&lt;/mxCell&gt;&lt;/root&gt;&lt;/mxGraphModel&gt;</diagram></mxfile>