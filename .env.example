# Local-only AWS settings. These are intentionally fake credentials.
AWS_ACCESS_KEY_ID=000000000000
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=ap-southeast-2
AWS_DEFAULT_REGION=ap-southeast-2
AWS_ENDPOINT_URL=http://localhost:4566

# Host-run backend resources created by `make deploy-local`.
ENVIRONMENT=local
TABLE_NAME=rmit-society-local
MEDIA_BUCKET=rmit-society-local-media
ANALYTICS_BUCKET=rmit-society-local-analytics
MODERATION_QUEUE_URL=http://localhost:4566/000000000000/rmit-society-local-moderation.fifo
IMAGE_QUEUE_URL=http://localhost:4566/000000000000/rmit-society-local-image.fifo
EVENT_QUEUE_URL=http://localhost:4566/000000000000/rmit-society-local-events.fifo
MODERATION_PROVIDER=local
IMAGE_PROVIDER=local
CORS_ORIGINS=http://localhost:5173

# Generated by `make deploy-local` in .cloudpulse/local.env.
COGNITO_USER_POOL_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=
COGNITO_AUDIENCE=
COGNITO_ISSUER=
COGNITO_JWKS_URL=

MINISTACK_ACCOUNT_ID=000000000000
MINISTACK_DOCKER_NETWORK=asm3-local
MINISTACK_IMAGE=ministackorg/ministack:latest
MINISTACK_LOG_LEVEL=INFO
MINISTACK_PORT=4566
