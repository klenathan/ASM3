# Non-secret runtime configuration. Copy to .env only for host development.
# Credentials come from AWS IAM Identity Center, AWS_PROFILE, or attached roles.
AWS_PROFILE=rmit-dev
AWS_REGION=ap-southeast-2
AWS_DEFAULT_REGION=ap-southeast-2
AWS_ACCOUNT_ID=123456789012

ENVIRONMENT=dev
API_VERSION=0.1.0
OPENAPI_ENABLED=true
# OPENAPI_SERVER_URL=https://example.cloudfront.net

# Replace with values from .deploy/dev.json after `make bootstrap`.
TABLE_NAME=rmit-society-dev
MEDIA_BUCKET=rmit-society-dev-123456789012-media
ANALYTICS_BUCKET=rmit-society-dev-123456789012-analytics
MODERATION_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/123456789012/rmit-society-dev-moderation.fifo
IMAGE_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/123456789012/rmit-society-dev-image.fifo
EVENT_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/123456789012/rmit-society-dev-events.fifo
ATHENA_DATABASE=rmit_society_dev
ATHENA_WORKGROUP=rmit-society-dev
ECS_CLUSTER=rmit-society-dev
ECS_TASK_DEFINITION=rmit-society-dev-analytics
ECS_SUBNET_IDS=subnet-replace-me-1,subnet-replace-me-2
ECS_SECURITY_GROUP_IDS=sg-replace-me

MODERATION_PROVIDER=aws
IMAGE_PROVIDER=aws
# Same-origin CloudFront routing needs no CORS entry. Set only for host web dev.
CORS_ORIGINS=http://localhost:5173

COGNITO_USER_POOL_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=ap-southeast-2_replace-me
COGNITO_AUDIENCE=replace-me
COGNITO_ISSUER=https://cognito-idp.ap-southeast-2.amazonaws.com/ap-southeast-2_replace-me
COGNITO_JWKS_URL=https://cognito-idp.ap-southeast-2.amazonaws.com/ap-southeast-2_replace-me/.well-known/jwks.json
