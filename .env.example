# Uncomment either static access keys or AWS_PROFILE. Do not use both approaches.
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_SESSION_TOKEN=""
# AWS_PROFILE=""

# Keep this aligned with aws_region in infras/terraform.tfvars.
AWS_REGION="us-east-1"
STATE_BUCKET=""

# Used only when exercising the content-analysis Lambda locally. Production
# stores this value in AWS Secrets Manager and passes its ARN to Lambda.
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="deepseek/<approved-model-slug>"

# Content-analysis (review) pipeline.
# CONTENT_ANALYSIS_MODE=off           # off | shadow | enforce (default: off)
# CONTENT_ANALYSIS_LAMBDA_FUNCTION="rmit-society-content-analysis"
# CONTENT_ANALYSIS_LAMBDA_QUALIFIER="prod"
# CONTENT_ANALYSIS_POLICY_VERSION="v1"
# CONTENT_ANALYSIS_PROMPT_VERSION="v1"
# ANALYSIS_TIMEOUT_MS=55000       # capped below the SQS visibility deadline
# ANALYSIS_MAX_IMAGES=4
# ANALYSIS_MAX_IMAGE_BYTES=5242880
# ANALYSIS_MAX_TOTAL_IMAGE_BYTES=10485760
